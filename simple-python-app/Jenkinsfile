pipeline {
    agent any

    environment {
        DOCKERHUB_USERNAME = 'mridhuldoc'
        DOCKERHUB_REPO = 'AWS-Continuous-Integration-Project'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        GIT_CREDENTIALS_ID = 'github-pat-mridul'
    }

    stages {
       // stage('Checkout') {
         //   steps {
           //     git branch: 'dev',
             //       credentialsId: "${GIT_CREDENTIALS_ID}",
               //     url: 'https://github.com/mridul002/AWS-Continuous-Integration-Project.git'
            //}
       // }

        stage('Install Dependencies') {
            steps {
                sh '''
                   python3 -m venv venv
                   . venv/bin/activate
                   pip install --upgrade pip
                   pip install -r simple-python-app/requirements.txt
               '''
            }
        }

        stage('Run Tests') {
            steps {
                sh 'python3 -m unittest discover simple-python-app'
            }
        }

        stage('Build & Push Docker Image') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds-id', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh """
                    docker login -u $DOCKER_USER -p $DOCKER_PASS
                    docker build -t $DOCKERHUB_USERNAME/$DOCKERHUB_REPO:$IMAGE_TAG .
                    docker push $DOCKERHUB_USERNAME/$DOCKERHUB_REPO:$IMAGE_TAG
                    docker tag $DOCKERHUB_USERNAME/$DOCKERHUB_REPO:$IMAGE_TAG $DOCKERHUB_USERNAME/$DOCKERHUB_REPO:latest
                    docker push $DOCKERHUB_USERNAME/$DOCKERHUB_REPO:latest
                    """
                }
            }
        }

        stage('Update Deployment YAML') {
            steps {
                withCredentials([usernamePassword(credentialsId: "${GIT_CREDENTIALS_ID}", usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PASS')]) {
                    sh """
                    sed -i 's|image: .*|image: $DOCKERHUB_USERNAME/$DOCKERHUB_REPO:$IMAGE_TAG|' simple-python-app/deployment.yaml
                    git config user.name "mridul002"
                    git config user.email "mridhulofficial002@gmail.com"
                    git add simple-python-app/deployment.yaml
                    git commit -m "Update image tag to $IMAGE_TAG" || echo "No changes to commit"
                    git push https://$GIT_USER:$GIT_PASS@github.com/mridul002/AWS-Continuous-Integration-Project.git dev
                    """
                }
            }
        }
    }
}


