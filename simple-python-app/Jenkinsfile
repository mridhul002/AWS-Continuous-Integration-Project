pipeline {
    agent any

    environment {
        DOCKERHUB_USERNAME = 'mridhuldoc'
        DOCKERHUB_REPO = 'AWS-Continuous-Integration-Project'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        GIT_CREDENTIALS_ID = 'github-pat-mridul'
    }

    stages {
        stage('Checkout') {
            steps {
                git credentialsId: 'github-pat-mridul', git branch: 'dev', url: 'https://github.com/mridul002/AWS-Continuous-Integration-Project.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'pip install -r simple-python-app/requirements.txt'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'python -m unittest discover simple-python-app'
            }
        }

        stage('Build & Push Docker Image') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds-id', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh """
                    docker login -u $DOCKER_USER -p $DOCKER_PASS
                    docker build -t $DOCKERHUB_USERNAME/$DOCKERHUB_REPO:latest .
                    docker push $DOCKERHUB_USERNAME/$DOCKERHUB_REPO:latest
                    """
                }
            }
        }

        stage('Update Deployment YAML') {
            steps {
                sh """
                sed -i 's|image: .*|image: $DOCKERHUB_USERNAME/$DOCKERHUB_REPO:$IMAGE_TAG|' simple-python-app/deployment.yaml
                git config user.name "mridul002"
                git config user.email "mridhulofficial002.com"
                git add simple-python-app/deployment.yaml
                git commit -m "Update image tag to $IMAGE_TAG"
                git push origin dev
                """
            }
        }

    }
}




